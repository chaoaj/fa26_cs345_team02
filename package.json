{
  "name": "bugs-vs-aliens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run dev",
    "prepare": "husky",
    "dev": "http-server . -a 127.0.0.1 -p 8080 -c-1",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint",
    "setup:browsers": "node scripts/playwright.mjs install chromium",
    "test": "node scripts/playwright.mjs test",
    "test:ui": "node scripts/playwright.mjs test --ui",
    "verify": "npm run check && npm test",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,html,css,md,yml,yaml,ts}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/p5": "1.7.7",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  }
}
