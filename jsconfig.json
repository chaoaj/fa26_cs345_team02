{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["p5"]
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": [
    "node_modules",
    "libraries",
    "dev",
    "tests",
    "playwright-report",
    "test-results",
    "coverage"
  ]
}
